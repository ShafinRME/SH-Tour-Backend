<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>New Booking — SH Tour</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f0ede8;
            font-family: Arial, sans-serif;
            padding: 40px 16px;
        }

        .wrap {
            max-width: 540px;
            margin: 0 auto;
        }

        .card {
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 32px rgba(8, 80, 65, .10);
        }

        .hero {
            background: #085041;
            padding: 30px 40px;
        }

        .hero-title {
            font-size: 22px;
            color: #ffffff;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .hero-sub {
            font-size: 13px;
            color: #9FE1CB;
        }

        .body {
            padding: 30px 40px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #E5E7EB;
            font-size: 14px;
        }

        .info-label {
            color: #6B7280;
            font-weight: 500;
        }

        .info-value {
            color: #1A1A1A;
            font-weight: 600;
        }

        .footer {
            background: #085041;
            padding: 18px 40px;
            text-align: center;
        }

        .footer p {
            color: #9FE1CB;
            font-size: 12px;
        }
    </style>
</head>

<body>
    <div class="wrap">
        <div class="card">
            <div class="hero">
                <div class="hero-title">🎉 New Booking Received!</div>
                <div class="hero-sub">A user just booked a tour on SH Tour</div>
            </div>
            <div class="body">
                <div class="info-row">
                    <span class="info-label">👤 User Name</span>
                    <span class="info-value">
                        <%= userName %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">📧 User Email</span>
                    <span class="info-value">
                        <%= userEmail %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">📞 Phone</span>
                    <span class="info-value">
                        <%= userPhone %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">🗺️ Tour</span>
                    <span class="info-value">
                        <%= tourTitle %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">👥 Guests</span>
                    <span class="info-value">
                        <%= guestCount %>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">💰 Amount</span>
                    <span class="info-value">BDT <%= totalAmount.toLocaleString() %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">🧾 Transaction ID</span>
                    <span class="info-value">
                        <%= transactionId %>
                    </span>
                </div>
                <div class="info-row" style="border-bottom:none;">
                    <span class="info-label">📅 Booking Date</span>
                    <span class="info-value">
                        <%= bookingDate %>
                    </span>
                </div>
            </div>
            <div class="footer">
                <p>SH Tour Admin Notification • shafin.nextgen1@gmail.com</p>
            </div>
        </div>
    </div>
</body>

</html>