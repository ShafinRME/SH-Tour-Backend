<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Booking Invoice – SH Tour</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#F3F4F6;color:#1A1A1A}
  .wrap{max-width:560px;margin:32px auto;background:#fff;border-radius:12px;overflow:hidden;border:1px solid #E5E7EB}
  .hdr{background:#085041;padding:24px 32px;display:flex;justify-content:space-between;align-items:center}
  .logo-area{display:flex;align-items:center;gap:12px}
  .logo-img{height:55px;width:auto;object-fit:contain}
  .logo-circle{width:44px;height:44px;background:#1D9E75;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#E1F5EE;font-weight:600;font-size:15px}
  .logo-text{color:#E1F5EE;font-size:18px;font-weight:600;line-height:1.2}
  .logo-sub{color:#9FE1CB;font-size:11px;margin-top:2px}
  .inv-block{text-align:right}
  .inv-label{color:#9FE1CB;font-size:10px;letter-spacing:.08em;text-transform:uppercase}
  .inv-id{color:#E1F5EE;font-size:13px;font-weight:600;margin-top:3px}
  .meta{padding:24px 32px;display:grid;grid-template-columns:1fr 1fr;gap:16px;border-bottom:1px solid #E5E7EB}
  .meta-label{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#6B7280;margin-bottom:4px}
  .meta-val{font-size:14px;font-weight:600;color:#1A1A1A}
  .meta-right{text-align:right}
  .pill{display:inline-flex;align-items:center;gap:5px;background:#E1F5EE;color:#085041;font-size:11px;font-weight:500;padding:3px 10px;border-radius:20px;margin-top:6px}
  .dot{width:6px;height:6px;border-radius:50%;background:#1D9E75;display:inline-block}
  .section{padding:20px 32px;border-bottom:1px solid #E5E7EB}
  .section-label{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#6B7280;margin-bottom:12px}
  .tour-box{background:#F9FAFB;border-radius:8px;padding:14px 16px;display:flex;justify-content:space-between;align-items:flex-start}
  .tour-title{font-size:14px;font-weight:600;color:#1A1A1A}
  .tour-sub{font-size:12px;color:#6B7280;margin-top:3px}
  .tour-amt{font-size:14px;font-weight:600;color:#1A1A1A;text-align:right;white-space:nowrap}
  .totals{padding:20px 32px;border-bottom:1px solid #E5E7EB}
  .row{display:flex;justify-content:space-between;font-size:13px;color:#6B7280;margin-bottom:8px}
  .divider{border:none;border-top:1px solid #E5E7EB;margin:12px 0}
  .total-row{display:flex;justify-content:space-between;font-size:15px;font-weight:600;color:#1A1A1A}
  .total-amt{color:#0F6E56}
  .ftr{background:#085041;padding:18px 32px;display:flex;justify-content:space-between;align-items:center}
  .ftr-logo{height:36px;width:auto;object-fit:contain;opacity:.85}
  .ftr-text{text-align:right}
  .ftr-text p{color:#9FE1CB;font-size:11px;line-height:1.6}
  .txn-bar{background:#04342C;padding:10px 32px}
  .txn-bar p{font-size:10px;color:#5DCAA5;letter-spacing:.03em}
</style>
</head>
<body>
<div class="wrap">

  <!-- Header -->
  <div class="hdr">
    <div class="logo-area">
      <% if (typeof logoBase64 !== 'undefined' && logoBase64) { %>
        <img src="<%= logoBase64 %>" alt="SH Tour Logo" class="logo-img">
      <% } else { %>
        <div class="logo-circle">SH</div>
        <div>
          <div class="logo-text">SH Tour</div>
          <div class="logo-sub">Your journey, our passion</div>
        </div>
      <% } %>
    </div>
    <div class="inv-block">
      <div class="inv-label">Invoice</div>
      <div class="inv-id">#<%= transactionId.slice(-8).toUpperCase() %></div>
    </div>
  </div>

  <!-- Billed to / Date -->
  <div class="meta">
    <div>
      <div class="meta-label">Billed to</div>
      <div class="meta-val"><%= userName %></div>
    </div>
    <div class="meta-right">
      <div class="meta-label">Booking date</div>
      <div class="meta-val">
        <%= new Date(bookingDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
      </div>
      <span class="pill">
        <span class="dot"></span>
        Payment confirmed
      </span>
    </div>
  </div>

  <!-- Tour details -->
  <div class="section">
    <div class="section-label">Tour details</div>
    <div class="tour-box">
      <div>
        <div class="tour-title"><%= tourTitle %></div>
        <div class="tour-sub">
          <%= guestCount %> guest<%= guestCount > 1 ? 's' : '' %>
        </div>
      </div>
      <div class="tour-amt">
        &#2547;<%= totalAmount.toLocaleString() %>
      </div>
    </div>
  </div>

  <!-- Totals -->
  <div class="totals">
    <div class="row">
      <span>
        Subtotal
        (<%= guestCount %> &times; &#2547;<%= Math.round(totalAmount / guestCount).toLocaleString() %>)
      </span>
      <span>&#2547;<%= totalAmount.toLocaleString() %></span>
    </div>
    <div class="row">
      <span>Service fee</span>
      <span>&#2547;0</span>
    </div>
    <hr class="divider">
    <div class="total-row">
      <span>Total paid</span>
      <span class="total-amt">&#2547;<%= totalAmount.toLocaleString() %></span>
    </div>
  </div>

  <!-- Footer -->
  <div class="ftr">
    <% if (typeof logoBase64 !== 'undefined' && logoBase64) { %>
      <img src="<%= logoBase64 %>" alt="SH Tour" class="ftr-logo">
    <% } %>
    <div class="ftr-text">
      <p>Thank you for traveling with SH Tour</p>
      <p>support@shtour.com</p>
    </div>
  </div>

  <!-- Transaction ID bar -->
  <div class="txn-bar">
    <p>Transaction ID: <%= transactionId %></p>
  </div>

</div>
</body>
</html>
